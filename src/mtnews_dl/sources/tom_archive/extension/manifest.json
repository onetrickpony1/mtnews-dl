{
  "manifest_version": 3,
  "key": "",
  "name": "tom-dl archive connection",
  "version": "2.0.0",
  "description": "Lets tom-dl (mtnews-dl) use this signed-in Chrome profile to download Times of Malta archive pages.",
  "permissions": [
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://timesofmalta.com/*",
    "http://127.0.0.1:18769/*"
  ],
  "action": {
    "default_title": "Connect tom-dl"
  },
  "background": {
    "service_worker": "background.js"
  }
}
